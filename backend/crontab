# Horários no fuso de CRON_TZ. O cron não executa estas linhas na subida do container.
CRON_TZ=America/Bahia
MAILTO=""
SHELL=/bin/sh
PATH=/usr/local/bin:/usr/bin:/bin

0 0 * * * . /etc/scheduler.env && cd /app && /usr/local/bin/python -m backend.app.collector.jobs.daily >> /proc/1/fd/1 2>> /proc/1/fd/2
30 0 1 * * . /etc/scheduler.env && cd /app && /usr/local/bin/python -m backend.app.collector.jobs.monthly >> /proc/1/fd/1 2>> /proc/1/fd/2
